{
  "title": "HungaroMet Weather & Forecast",
  "config": {
    "step": {
      "user": {
        "title": "Set up HungaroMet Weather & Forecast",
        "data": {
          "name": "Name",
          "distance_km": "Station search radius (km)",
          "forecast_settlement": "Forecast settlement (optional)",
          "location": "Location",
          "devices": "Services",
          "national_radar": "National radar image"
        },
        "data_description": {
          "name": "The name of this entry and its services (e.g. Home).",
          "distance_km": "Sensors show the average of all HungaroMet stations with data within the search radius of the selected location. If no station with data is in range, the nearest one with data is used.",
          "forecast_settlement": "Hungarian settlement for the HungaroMet Forecast service, e.g. Debrecen. Use accented letters. Leave empty for no forecast.",
          "location": "Where the station search radius is measured from, and which regional radar image is shown: Home Assistant's home location, or the forecast settlement.",
          "devices": "The weather station services and the regional radar image of this entry. Only the ticked ones are downloaded and added.",
          "national_radar": "Adds the national radar image, as a separate Radar entry. To add only the radar, leave the name and the settlement empty and untick every service."
        }
      }
    },
    "error": {
      "settlement_not_found": "met.hu does not know this settlement. Check the spelling, including accents (é, á, ő …).",
      "cannot_connect": "Could not reach met.hu. Try again later.",
      "settlement_required": "Enter a forecast settlement to use it as the location.",
      "name_required": "Enter a name.",
      "invalid_response": "met.hu sent an unexpected answer. Try again later.",
      "settlement_in_use": "Another entry already has this forecast settlement.",
      "home_in_use": "Another entry already measures at Home. For this one, enter a forecast settlement and choose it as the location.",
      "nothing_selected": "Tick at least one service, or enter a forecast settlement.",
      "nothing_or_radar": "Tick at least one service, or enter a forecast settlement. To add only the radar, leave the name empty too and keep National radar image ticked."
    },
    "abort": {
      "already_configured": "An entry with this forecast settlement and location already exists."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "HungaroMet Weather & Forecast options",
